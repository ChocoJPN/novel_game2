define h = Character('藤沢透', color="#476ff3")
define hatena = Character('?', color="#655f5f")
define k = Character('鎌倉詩乃', color="#ef5e60")
define s = Character('愛川先生', color="#49f869")
define tannin = Character('担任', color="#faf876")
define m = Character('真鶴千景', color="#fa76ce")

default book = False

label start:

    "夕暮れ、高校生なら青春を思い浮かべる人もいるだろう。"

    "しかし、俺は真逆の説教というものを受けていた。"

    scene syokuinsitu_yugata
    with fade

    s "君には文章を書く能力すらないのか。"
    
    "現国教師、愛川文乃は俺のA4レポート用紙を上下に揺らし、机を叩いていた。"

    h "識字はあります。ただ書くことがなかっただけです。"

    s "『高校生活を振り返って』をなしと答えるやつがいるか。"

    h "いると思いますよ、近頃は了解を『り』と略す人がいるぐらいですからね。"

    s "それは縮約語の話だろう。私が言っているのはこの空白のレポートだ。"

    "愛川先生は学年、クラス、俺の名前だけが書かれたほぼ白紙の紙を見せてきた。"

    h "心がきれいな人には見えるように書いたので..."

    s "小僧、言いたいことはわかるな？"

    h "わかりましたから、指を鳴らすのはやめてください！"

    s "わかったならいい。"

    s "しかしなぁ..."
    
    s "このままレポートを再提出では罪としては軽すぎるな。"

    s "よし、君に罰を与えよう。"

    h "えぇ、流してもらえる流れだと思ったのに。"

    s "罪には罰を、当たり前のことだ。"

    s "まあとりあえずついてきたまえ。"

    "そういうと愛川先生は職員室を出ていった。"

    s "逃げれると思うなよ。"

    h "ですよねぇ～"

    "俺は仕方なく愛川先生の後ろをついていった。"

    scene rouka_yugata
    with fade

    h "どこに向かってるんですか？"

    s "まあ、そう焦るな。"

    s "直にわかる。"

    "やがて先生が止まり、教室前に立つととそこには名前のない教室があった。"

    scene kyositu_yugata1
    with fade
    
    "今日は風の強い日だった。"

    "だからか教室のカーテンは大きく広がり蝶々のように舞って夕日が斜めに差し込み、視界の端できらきらと揺れた。"

    "そんな中、彼女は立っていた。"

    hatena "遅い！"

    s "すまない、この天邪鬼に時間を取らされた。"

    h "おい、だれが妖怪だ。"

    "そんな言い合いをしていると彼女はきょとんとした表情で俺を見てきた。"

    hatena "面白そうな人だね。"

    s "ああ、少々ひねくれているが面白いぞ。"

    "人のことを馬鹿にして楽しいのかこいつらは。"

    hatena "それはそうと、私たちを集めた理由は？"

    s "そう、君たちには文芸部を救ってもらいたいのだ。"

    "俺と彼女は顔を合わせて頭を？にしていた。"

    h "どういうことです？文芸部？"

    s "順を追って話そう。"

    s "まず、我が校の文芸部なのだが、現在部員が0なんだ。"

    s "去年までは5人ほどいたのだが皆三年生でな。"

    s "卒業してしまって、今はもぬけの殻なのだ。"

    h "だから部員を集めて文芸部を再建しろと？"

    s "話が早くて助かるな。"

    h "でもなんで俺なんですか？"

    s "それは内緒だ。"

    "そういうと先生は教室を出て行ってしまった。"

    s "{size=-8}いずれわかるさ...{/size}"

    "秒針の音が聞こえる。"

    "そんな静寂を切ったのは彼女だった。"

    hatena "君、名前は？"

    h "藤沢透。"

    $ unlock_affection("k")
    k "私は鎌倉詩乃。"

    k "これからよろしくね。"

    "彼女は笑顔で言った。"

    h "どうして鎌倉はこんな状況を受け入れられるだ？"

    k "う～ん..."

    k "困ってる人がいるから？"

    "俺はその言葉を聞いたときある感情を抱いた。"

    "だけど、俺はその感情を抑えて言った。"

    h "偉いな。"

    k "そう？"

    k "困っている人がいたら助けるのは当然じゃない？"

    h "それをしない人間がこの世にはいっぱいいるんだよ。"

    k "へんなの。"

    "彼女は悪気もなくそんなことを言った。"

    k "今日はもう遅いし、明日また放課後ここに集合で。"

    h "了解。"

    "俺がそういうと彼女はバッグをもって一目散に出て行ってしまった。"

    h "なんだあいつ。"

    "俺は彼女に聞こえない声でそう言った。"

    scene kyositu2_yugata
    with fade

    "キーンコーンカーンコーン"

    tannin "今日はここまで、寄り道せず帰れよ～。"

    "俺は昨日のことをすっかり忘れて帰る支度をしていた。"

    "すると、廊下からダッダッっと走る音がした。"

    k "藤沢君いますか～"

    "彼女はクラスの全員に伝わるほどの大声で言った。"

    "俺は気づかれないようにバックを枕に寝る仕草をした。"

    "しかし、そんな偽造も見破られ彼女は俺の前に現れた。"

    k "なんで寝てるの？"

    h "おなかが痛いだけだ。"

    k "そっか、じゃあ行こう。"

    "そういうと俺の手を取りながら部室へと連行された。"

    scene kyositu_yugata1
    with fade

    h "それで、今日は何をするんだ？"

    k "もちろん、部員集めだよ。"

    h "伝手はあるのか？"

    k "一応いるよ。"

    k "バレー部のチカちゃん。"

    h "バレー部って、掛け持ちするってことか？"

    k "そうだね。"

    h "そうだねって、その子は了承してるのか？"

    k "まあ入ってくれるんじゃない？"

    h "お前なぁ。"

    k "とりあえず、体育館行こう！"

    "そうして俺らは運動部の活動の場、体育館へ向かった。"

    scene taikukan_yugata
    with fade

    k "あそこで3番のビブスを着てるのがチカちゃん。"

    h "チカちゃんって言われても俺はわからないんだが。"

    k "あれ、同じクラスじゃないの？"

    "同じクラスだったのか、そんな奴いたかな。"

    "そんなことを考えていると、鎌倉が俺を怪しげに見てきたので言い訳をしておいた。"

    h "女子と関わりが少ないだけだ。"

    k "ふ～ん。"

    h "そんなことより、どう見てもあいつ忙しそうだぞ。"

    k "そうだね..."

    k "終わるまで待つ！"

    h "マジで言ってんのか。"

    "俺らはバレー部が終わるまで1時間半も待った。"

    "そしてバレー部たちがぞろぞろと体育館が出てくる中、彼女はいた。"

    k "おーい、チカちゃん～"

    "そうすると彼女はこっちに気付いたのか急いでこちらに向かってきた。"

    m "詩乃じゃん、どうしたの？"

    k "それがかくかくしかじかで。"

    "そういうと鎌倉はチカちゃんとやらに俺らの要件を伝えた。"

    k "てことでお願いできるかな？"

    m "そうしたいのはやまやまなんだけど、試合も近いしそれに..."

    "彼女は何か言いかけたが、そこで彼女は口をつぐんだ。"

    m "だからごめんね。"
    
    k "そっか...わかった。"

    "鎌倉は悲しそうにしながらも切り替えるように言った。"

    k "とりあえず、今日は帰ろっか。"

    "こうして俺らは暗くなっていく校舎を背に帰路についた。"

    scene black with fade

    "次の日"

    scene kyositu_yugata1
    with fade

    "それでどうするんだ？"

    "俺らはチカちゃんこと真鶴千景の断りによってどん底に落とされていた。"

    k "どうしようか？"

    h "残念ながら、俺に伝手は皆無だぞ。"

    k "だろうね"

    "ちょっとは気を使えよ、傷ついちゃうだろ。"

    k "困ったなぁ..."

    k "チカちゃんの弱みを握ればいいんじゃない？"

    h "お前に人情はないのか。"

    k "別に脅すわけじゃないよ。"

    k "チカちゃん真面目だから、恩とか返されたら入部してくるんじゃないかって思っただけ。"

    h "恩ねぇ..."

    "俺らは特に策も思いつかず、今日は解散になった。"

    "かといって、特に用があるわけでもないが俺は帰りに体育館に寄った。"

    scene taikukan_yugata
    with fade

    "体育館の中には誰もいなかった。"

    h "今日は練習ないのか。"

    "諦めて帰ろうとしたとき、体育館近くにある運動部の部室から笑い声が聞こえてきた。"

    "俺は帰りながらその部室の横を通ると気になる話が聞こえてきた。"

    hatena "うるせんだよな、あいつら。"

    hatena "まじでそう、弱いんだから譲れよな。"

    "そんな聞くだけでもイラつくようなセリフが聞こえてきた。"

    hatena "特に真鶴、あいつはまじうぜぇ。"

    hatena "俺らの方が大会成績いいのに、平等に分けろとか"

    hatena "何様のつもりだよ。"

    hatena "そこでいいこと思いついたんだよ。"

    hatena "なんだ？"

    hatena "あいつらもうすぐ大会だろ？"

    hatena "だから、俺らも大会があるって言って体育館を使えなくしようぜ。"

    "まるで悪魔のような提案が出されているのを俺は聞いてしまった。"

    h "どうすっかな。"

    "なんて面倒なことになったのだと思いながら、俺は颯爽にそこを去った。"

    scene black with fade

    "次の日"

    scene kyositu_yugata1
    with fade

    ""






    






    

    





    



    

    



    







    


    
